{
  "runs": 1,
  "checks": [
    {
      "command": ["dotnet", "test", "--solution", "RaggidyRag.slnx"],
      "folder": ".",
      "ignores": [
        "README.md",
        "CLAUDE.md",
        ".gitignore",
        ".gitattributes",
        ".claude/settings.json",
        "docs/agents/suite.json",
        "docs/agents/loop.json",
        "docs/agents/placement-checks.md",
        "docs/agents/domain.md",
        "docs/agents/issue-tracker.md",
        "docs/agents/surfaces.md",
        "docs/agents/review-architecture.md",
        "docs/agents/review-spec.md",
        "docs/agents/review-standards.md"
      ]
    },
    {
      "command": ["npm", "test"],
      "folder": "src/RaggidyRag.Web",
      "ready": {
        "command": ["npm", "ci"],
        "message": "The page's packages did not install. Install Node and npm, and run this again.",
        "unless": "src/RaggidyRag.Web/node_modules"
      },
      "ignores": [
        "README.md",
        "CLAUDE.md",
        ".gitignore",
        ".gitattributes",
        ".editorconfig",
        ".claude/settings.json",
        "docs",
        "global.json",
        "Directory.Build.props",
        "BannedSymbols.txt",
        "RaggidyRag.slnx",
        "src/RaggidyRag.Api",
        "src/RaggidyRag.AppHost",
        "src/RaggidyRag.ServiceDefaults",
        "tests"
      ]
    }
  ]
}
